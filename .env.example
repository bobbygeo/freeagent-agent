# From https://dev.freeagent.com/apps (or sandbox dashboard)
FREEAGENT_CLIENT_ID=
FREEAGENT_CLIENT_SECRET=

# Must match an OAuth Redirect URI registered on the FreeAgent app
# Docker / local server uses 3847 (not 3000) to avoid clashing with other apps
FREEAGENT_REDIRECT_URI=http://127.0.0.1:3847/oauth/callback

# sandbox | production
FREEAGENT_ENV=sandbox

# Host CLI default; Docker overrides to /app/data/.oauth-tokens.json
FREEAGENT_TOKEN_PATH=.oauth-tokens.json

PORT=3847
# Use 0.0.0.0 inside Docker (set by compose). Local CLI server: 127.0.0.1
BIND_HOST=127.0.0.1
